generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(100)
  products Product[]

  @@map("categories")
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(200)
  brand       String        @default("") @db.VarChar(100)
  categoryId  Int           @map("category_id")
  description String?
  imageUrl    String?       @map("image_url") @db.VarChar(500)
  emoji       String?       @db.VarChar(20)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  specs       ProductSpec[]
  listings    Listing[]
  favorites   Favorite[]

  @@map("products")
}

model ProductSpec {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  specText  String  @map("spec_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specs")
}

model Store {
  id             Int       @id @default(autoincrement())
  name           String    @unique @db.VarChar(100)
  baseUrl        String    @map("base_url") @db.VarChar(255)
  affiliateParam String?   @map("affiliate_param") @db.VarChar(50)
  affiliateId    String?   @map("affiliate_id") @db.VarChar(100)
  listings       Listing[]

  @@map("stores")
}

model Listing {
  id            Int           @id @default(autoincrement())
  productId     Int           @map("product_id")
  storeId       Int           @map("store_id")
  price         Decimal       @db.Decimal(10, 2)
  originalPrice Decimal?      @map("original_price") @db.Decimal(10, 2)
  rating        Decimal?      @db.Decimal(2, 1)
  reviewsCount  Int           @default(0) @map("reviews_count")
  shippingInfo  String?       @map("shipping_info") @db.VarChar(255)
  productUrl    String        @map("product_url") @db.VarChar(500)
  inStock       Boolean       @default(true) @map("in_stock")
  promoEndsAt   DateTime?     @map("promo_ends_at") @db.Date
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  priceHistory  PriceHistory[]

  @@unique([productId, storeId])
  @@map("listings")
}

model PriceHistory {
  id         BigInt   @id @default(autoincrement())
  listingId  Int      @map("listing_id")
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique @db.VarChar(255)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  displayName  String?        @map("display_name") @db.VarChar(100)
  avatarUrl    String?        @map("avatar_url") @db.Text
  role         String         @default("user") @db.VarChar(20)
  status       String         @default("active") @db.VarChar(20)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  searchHistory SearchHistory[]
  adminAuditLogs AdminAuditLog[]
  favorites    Favorite[]

  @@map("users")
}

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String   @db.VarChar(20)
  entity      String   @db.VarChar(20)
  entityId    String   @map("entity_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_audit_logs")
}

model SearchHistory {
  id         BigInt   @id @default(autoincrement())
  userId     Int      @map("user_id")
  keyword    String   @db.VarChar(255)
  searchedAt DateTime @default(now()) @map("searched_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt])
  @@map("search_history")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}
